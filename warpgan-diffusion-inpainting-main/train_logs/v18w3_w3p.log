wplus:
  mode: s1_mapper
  gate_value: 3.0
  init_from_stage_c: false
reference:
  use: true
  use_mirror: true
  real_primary: mirror
  gate_init: 0.5
  lr: 5.0e-06
  local_window_k: 0
  local_gate_init: 0.25
brushnet:
  init: pretrained
  lr: 1.0e-05
  use_8bit_adam: true
  gradient_checkpointing: true
losses:
  eps_weight: 1.0
  synth_texture: full
  synth_lowpass_sigma: 2.0
  real_pass1:
    forward: true
    visible_weight: 1.0
    hole_weight: 0
    blind_struct_weight: 0
    mirror_anchor: true
  pixel:
    max_timestep: 200
    x0_clip: 3.0
    resolution: 256
    patch_latent: 32
    apply_to_synth: false
    l1_weight: 0
    resnet_pl_weight: 0
    id_weight: 0
    weights_path: ./pretrained_models/LaMa_perceptual_loss_models
  latent:
    weight: 0
  lpips:
    weight: 0
  adversarial:
    weight: 0
    kind: r1
    gp_coef: 0.001
    mask_as_fake_target: false
    allow_scale_mask: true
  feature_matching:
    weight: 0
  x0:
    enable: true
    mode: invsr
    t_max: 300
    w_ldif: 1.0
    w_lfm: 2.0
    w_ldis: 0.1
    dis_warmup: 3000
    latent_bound: 10.0
    l1_weight: 1.0
    clip: 8.0
    res_latent: 32
    d_real: paired_target
  preserve:
    weight: 0
    teacher_wplus: true
  discriminator:
    kind: pix2pixhd_nlayer
    input_nc: 3
    ndf: 64
    n_layers: 4
  optimizers:
    discriminator:
      lr: 0.0001
log:
  image_interval: 500
  board_interval: 50
  val_interval: 2000
  save_interval: 10000
  use_wandb: false
smoke:
  check: true
  fix_timestep: null

